PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# GitHub OAuth (required for user login + Copilot license verification)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback

# Firebase Admin SDK
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

# Copilot API (OpenAI-compatible endpoint)
# LLM provider selection:
# - auto (default): choose github-models when token looks like PAT, else copilot
# - copilot: force https://api.githubcopilot.com
# - github-models: force https://models.github.ai/inference
LLM_PROVIDER=auto

# Shared token variable used by both providers.
# - copilot provider: use Copilot-compatible token
# - github-models provider: use GitHub PAT (ghp_ / github_pat_) with Models access
COPILOT_API_URL=https://api.githubcopilot.com
GITHUB_MODELS_API_URL=https://models.github.ai/inference
COPILOT_API_TOKEN=
COPILOT_MODEL=gpt-4.1
GITHUB_MODELS_MODEL=openai/gpt-4.1

# Browser control
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_MCP_COMMAND=playwright-mcp
PLAYWRIGHT_MCP_ARGS=["--headless"]
PLAYWRIGHT_EXPLORE_MAX_SNAPSHOTS=8
PLAYWRIGHT_EXPLORE_MAX_CANDIDATES=5
PLAYWRIGHT_EXPLORE_MAX_DEPTH=2
